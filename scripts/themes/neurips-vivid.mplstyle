# NeurIPS Vivid — NeurIPS/ICML spotlight inspired
# Vibrant but tasteful, high contrast, bold lines

font.family: sans-serif
font.size: 11
axes.labelsize: 12
axes.titlesize: 13
axes.titleweight: bold
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

axes.facecolor: FFFFFF
figure.facecolor: FFFFFF
axes.edgecolor: CCCCCC
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False

axes.grid: True
grid.color: EEEEEE
grid.linestyle: -
grid.alpha: 0.35
grid.linewidth: 0.6

axes.prop_cycle: cycler('color', ['0077BB', 'EE7733', '009988', 'CC3311', '33BBEE', 'EE3377', 'BBBBBB'])

lines.linewidth: 2.2
lines.markersize: 8

legend.frameon: True
legend.framealpha: 0.85
legend.edgecolor: CCCCCC
legend.fancybox: True

figure.dpi: 200
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.08

xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
