# Clean Modern — DeepMind/Google Brain inspired
# Minimal, airy, sans-serif, soft palette, generous whitespace

font.family: sans-serif
font.size: 11
axes.labelsize: 12
axes.titlesize: 13
axes.titleweight: bold
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

axes.facecolor: FAFAFA
figure.facecolor: FAFAFA
axes.edgecolor: CCCCCC
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False

axes.grid: True
grid.color: E5E5E5
grid.linestyle: -
grid.alpha: 0.5
grid.linewidth: 0.6

axes.prop_cycle: cycler('color', ['4C72B0', 'DD8452', '55A868', 'C44E52', '8172B3', '937860', 'DA8BC3'])

lines.linewidth: 2.0
lines.markersize: 7

legend.frameon: True
legend.framealpha: 0.85
legend.edgecolor: CCCCCC
legend.fancybox: True

figure.dpi: 200
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.08

xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
