# Nature Elegant — Nature/Science journal inspired
# Serif, refined, understated, no grid, classic academic

font.family: serif
font.size: 10
axes.labelsize: 11
axes.titlesize: 12
axes.titleweight: bold
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9

axes.facecolor: FFFFFF
figure.facecolor: FFFFFF
axes.edgecolor: 888888
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False

axes.grid: False
grid.color: DDDDDD
grid.linestyle: --
grid.alpha: 0.3
grid.linewidth: 0.5

axes.prop_cycle: cycler('color', ['2271B2', 'F37021', '329932', 'B22222', '6A3D9A', 'A6761D', 'E6AB02'])

lines.linewidth: 1.8
lines.markersize: 6

legend.frameon: True
legend.framealpha: 0.9
legend.edgecolor: CCCCCC
legend.fancybox: True

figure.dpi: 200
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.08

xtick.direction: in
ytick.direction: in
xtick.major.size: 4
ytick.major.size: 4
