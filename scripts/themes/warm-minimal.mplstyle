# Warm Minimal — ICLR 2025 warm aesthetic
# Warm tones, rounded feel, modern, slightly off-white background

font.family: sans-serif
font.size: 11
axes.labelsize: 12
axes.titlesize: 13
axes.titleweight: bold
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

axes.facecolor: FEFEFA
figure.facecolor: FEFEFA
axes.edgecolor: CCCCCC
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False

axes.grid: True
grid.color: E8E4DE
grid.linestyle: -
grid.alpha: 0.4
grid.linewidth: 0.6

axes.prop_cycle: cycler('color', ['E07A5F', '3D405B', '81B29A', 'F2CC8F', '5B8E7D', 'BC6C25', '8ECAE6'])

lines.linewidth: 2.0
lines.markersize: 7

legend.frameon: True
legend.framealpha: 0.85
legend.edgecolor: D5D0C8
legend.fancybox: True

figure.dpi: 200
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.08

xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
